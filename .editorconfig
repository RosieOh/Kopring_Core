root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# IntelliJ 기본 포맷과 맞춘다 (ktlint_official 보다 기존 코드와의 차이가 적다)
ktlint_code_style = intellij_idea
max_line_length = 150
# 생성자 파라미터는 하나라도 있으면 한 줄에 하나씩 (끝에 쉼표)
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1
# 함수 파라미터는 3개부터 한 줄에 하나씩
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3
# 식 본문(= ...)은 여러 줄일 때만 다음 줄에서 시작
ktlint_function_signature_body_expression_wrapping = multiline

[src/test/**.kt]
# 테스트 이름은 백틱으로 감싼 한글 문장을 쓴다
ktlint_standard_function-naming = disabled
# Kotest 스펙은 관례대로 `class X : FunSpec({ ... })` 한 줄로 시작한다 (본문 전체가 한 단계 더 들여써지지 않게)
ktlint_standard_class-signature = disabled

[*.{yml,yaml,json}]
indent_size = 2
